# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development
AWS_REGION=eu-central-1

# Local PostgreSQL database connection
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/digitaltwin

# ── Fully local mode (no AWS) ───────────────────────────────────────────────
# Swaps Bedrock for Ollama. Requires a local Postgres with pgvector, plus the
# two models pulled. Ingestion must run with the SAME provider — vectors from
# one embedding model are not searchable by another, and the dimensions differ.
#
#   AI_PROVIDER=ollama
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_EMBEDDING_MODEL=bge-m3
#   OLLAMA_LLM_MODEL=qwen3.6:27b
