# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development
AWS_REGION=eu-central-1

# ── Default: run against the real cloud vector store ────────────────────────
# VECTOR_STORE defaults to "s3vectors", so a local backend serves real grounded
# answers with nothing but AWS credentials. Get the names from Terraform:
#
#   cd terraform && terraform output -raw vector_bucket_name
#   cd terraform && terraform output -raw vector_index_name
#
VECTOR_BUCKET_NAME=digital-twin-vectors-xxxxxxxx
VECTOR_INDEX_NAME=digital-twin-docs

# ── Fully local mode (no AWS at all) ────────────────────────────────────────
# Swaps Bedrock for Ollama AND S3 Vectors for a local Postgres, since S3 Vectors
# has no local emulator. Requires Postgres with pgvector plus both models pulled.
#
#   AI_PROVIDER=ollama
#   VECTOR_STORE=pgvector
#   DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/digitaltwin
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_EMBEDDING_MODEL=bge-m3
#   OLLAMA_LLM_MODEL=qwen3.6:27b
#
# ⚠️  These two settings go together. AI_PROVIDER=ollama with the DEFAULT
# VECTOR_STORE=s3vectors will write bge-m3 vectors into the cloud index, and
# nothing will stop it: bge-m3 and Titan v2 are both 1024-dimensional, so the
# dimensions match and the write succeeds. Retrieval then compares Titan-embedded
# questions against bge-m3 documents, which is meaningless — the twin answers from
# near-random chunks, with no error anywhere. If you set AI_PROVIDER=ollama, set
# VECTOR_STORE=pgvector in the same breath.
